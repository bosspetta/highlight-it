{
  "manifest_version": 3,
  "name": "Highlight it",
  "version": "1.0.0",
  "description": "Highlight text on any web page, add names and notes, and jump back to it later.",
  "homepage_url": "https://github.com/bosspetta/highlight-it",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "shared.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Highlight it",
    "default_icon": "icons/icon.svg"
  },
  "sidebar_action": {
    "default_title": "Highlight it",
    "default_panel": "library.html?view=sidebar",
    "default_icon": "icons/icon.svg",
    "open_at_install": false
  },
  "options_ui": {
    "page": "library.html",
    "open_in_tab": true
  },
  "commands": {
    "highlight-selection": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Highlight the selected text with the last used color"
    },
    "_execute_sidebar_action": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Show or hide the highlights sidebar"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "css": [
        "highlights.css"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "highlight-it@bosspetta",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    }
  }
}
